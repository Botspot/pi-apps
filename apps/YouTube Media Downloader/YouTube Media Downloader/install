#!/bin/bash
# Install dependencies
sudo apt update
sudo apt install -y python3 python3-gi gir1.2-gtk-3.0 python3-pip ffmpeg at-spi2-core
pip3 install --break-system-packages yt-dlp 2>/dev/null || pip3 install yt-dlp

# Install app package
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
sudo dpkg -i "$DIR/yt-downloader_1.0.0_all.deb" || sudo apt --fix-broken install -y

