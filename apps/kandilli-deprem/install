#!/bin/bash
set -e

echo "Kandilli Deprem Takip Kuruluyor... / Installing Kandilli Earthquake Tracker..."
sudo apt update
sudo apt install -y python3 python3-feedparser python3-gi gir1.2-gtk-3.0 python3-notify2 wget

DEB_URL="https://github.com/teknologvolkanozdemir/kandilli-deprem/releases/download/v1.0.0.0/kandilli-deprem_1.0.0_all.deb"

wget -qO /tmp/kandilli-deprem_1.0.0_all.deb "$DEB_URL" || { echo "Hata / Error: Paket indirilemedi / Download failed!"; exit 1; }
sudo apt install -y /tmp/kandilli-deprem_1.0.0_all.deb
rm -f /tmp/kandilli-deprem_1.0.0_all.deb

echo "Kurulum başarıyla tamamlandı! / Installation completed successfully!"
