#!/bin/bash
# Blogger Desktop Kurulum Betiği

DIRECTORY="$(cd "$(dirname "$0")" && pwd)"

# Bağımlılıkları yükle
sudo apt update
sudo apt install -y python3-gi python3-gi-cairo gir1.2-gtk-3.0 gir1.2-webkit2-4.1 || exit 1

# deb paketini kur
sudo dpkg -i "$DIRECTORY/blogger-desktop_1.0.0-1_arm64.deb" || sudo apt-get install -f -y || exit 1

echo "Blogger Desktop başarıyla kuruldu!"
