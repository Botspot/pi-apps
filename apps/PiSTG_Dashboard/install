#!/bin/bash

# Pi-Apps install script for Pi Dashboard
# Installs a Flask-based web dashboard for Raspberry Pi, accessible from any device on the LAN.

set -e

# Define error() if not already provided by Pi-Apps.
if ! type error >/dev/null 2>&1; then
  error() {
    echo -e "\nERROR: $1" >&2
    exit 1
  }
fi

INSTALL_DIR="/opt/Pi-Dashboard"
REPO_URL="${PI_DASHBOARD_REPO:-https://github.com/stghecker/raspberry-pi-interface-server}"
BRANCH="${PI_DASHBOARD_BRANCH:-main}"

# Run a command with root privileges if needed.
as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif command -v sudo >/dev/null 2>&1; then
    sudo "$@"
  else
    "$@"
  fi
}

# Install system dependencies (Fixed package names)
echo "Checking system dependencies…"
NEED_APT=0
command -v python3 >/dev/null 2>&1 || NEED_APT=1
python3 -c "import venv" 2>/dev/null || NEED_APT=1
command -v pip3 >/dev/null 2>&1 || python3 -m pip --version >/dev/null 2>&1 || NEED_APT=1

if [ "$NEED_APT" -eq 1 ]; then
  if command -v install_packages >/dev/null 2>&1; then
    install_packages python3 python3-venv python3-pip || error "Failed to install system dependencies!"
  else
    as_root apt-get update -y || error "apt-get update failed!"
    as_root apt-get install -y python3 python3-venv python3-pip || error "Failed to install python3-venv packages!"
  fi
fi

# Set up safe structural location directory
as_root mkdir -p "$INSTALL_DIR"
as_root chown -R $(whoami):$(whoami) "$INSTALL_DIR"

echo "Downloading Pi Dashboard…"
if [ -d "$INSTALL_DIR/.git" ]; then
  rm -rf "$INSTALL_DIR"
  mkdir -p "$INSTALL_DIR"
fi
git clone --depth 1 -b "$BRANCH" "$REPO_URL" "$INSTALL_DIR" || error "Failed to clone repository!"

cd "$INSTALL_DIR" || error "Cannot enter install directory!"

echo "Creating Python virtual environment…"
python3 -m venv .venv || error "Failed to create virtual environment!"
.venv/bin/pip install --quiet --upgrade pip

echo "Installing Python dependencies…"
.venv/bin/pip install --quiet -r requirements.txt || error "Failed to install Python dependencies!"

# CREATE TRUE BACKGROUND SYSTEMD SERVICE
echo "Registering background engine boot loader service…"
as_root tee /etc/systemd/system/pi-dashboard.service >/dev/null <<EOF
[Unit]
Description=Pi Dashboard Local Web Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=$INSTALL_DIR/webserver
ExecStart=$INSTALL_DIR/.venv/bin/python app.py
Restart=always

[Install]
WantedBy=multi-user.target
EOF

# Activate background processes
as_root systemctl daemon-reload
as_root systemctl enable pi-dashboard.service
as_root systemctl start pi-dashboard.service

# Create an execution desktop helper shortcut link launcher configuration
echo "Creating desktop menu launch link..."
DESKTOP_CONTENT="[Desktop Entry]
Name=Pi Dashboard
Comment=Open Pi Dashboard tracking portal monitor panel UI
Exec=xdg-open http://localhost:5000
Icon=utilities-system-monitor
Terminal=false
Type=Application
Categories=System;Monitor;Network;"

USER_DESKTOP="$HOME/.local/share/applications/pi-dashboard.desktop"
mkdir -p "$HOME/.local/share/applications"
echo "$DESKTOP_CONTENT" > "$USER_DESKTOP"

echo ""
echo "==============================================="
echo "  Pi Dashboard installed successfully!"
echo "  Running actively as a true background service."
echo ""
echo "  The server starts automatically on system boot."
echo "  Access URL: http://$(hostname -I | awk '{print $1}'):5000"
echo "==============================================="
