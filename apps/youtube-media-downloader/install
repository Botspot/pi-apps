#!/bin/bash
# YouTube Media Downloader Kurulum Betiği

DEB_URL="https://github.com/teknologvolkanozdemir/youtube-media-downloader/releases/download/v1.0/youtube-media-downloader_1.0.0_all.deb"
TMP_DEB="/tmp/youtube-media-downloader_1.0.0_all.deb"

echo "Gerekli bağımlılıklar kuruluyor..."
sudo apt update
sudo apt install -y python3 python3-gi gir1.2-gtk-3.0 ffmpeg lxterminal wget curl

echo "En güncel yt-dlp sürümü kuruluyor..."
sudo curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp
sudo chmod a+rx /usr/local/bin/yt-dlp

echo "YouTube Media Downloader paketi indiriliyor..."
wget --no-check-certificate -O "$TMP_DEB" "$DEB_URL" || curl -L -o "$TMP_DEB" "$DEB_URL"

echo "Sisteme kuruluyor..."
sudo apt install -y "$TMP_DEB"
rm -f "$TMP_DEB"

echo "YouTube Media Downloader v1.0.0 başarıyla kuruldu!"
